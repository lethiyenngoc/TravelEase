extends ../layouts/default.pug

block main
  if (permissions.includes("dashboard-view"))
    h1.box-title Tổng quan

    //- Section 1
    .section-1
      .inner-item
        .inner-icon
          img(src="/admin/assets/images/section-1-icon-1.svg")
        .inner-content
          .inner-title Quản trị viên
          .inner-number #{overview.totalAdmin.toLocaleString("vi-VN")}
      .inner-item
        .inner-icon
          img(src="/admin/assets/images/section-1-icon-1.svg")
        .inner-content
          .inner-title Người dùng
          .inner-number #{overview.totalUser.toLocaleString("vi-VN")}
      .inner-item
        .inner-icon
          img(src="/admin/assets/images/section-1-icon-2.svg")
        .inner-content
          .inner-title Đơn hàng
          .inner-number #{overview.totalOrder.toLocaleString("vi-VN")}
      .inner-item
        .inner-icon
          img(src="/admin/assets/images/section-1-icon-3.svg")
        .inner-content
          .inner-title Doanh thu
          .inner-number #{overview.totalPrice.toLocaleString("vi-VN")}đ
    //- End Section 1

    //- Section 2
    .section-2
      .inner-head
        h2.inner-title Biểu đồ doanh thu
        .inner-filter
          input(
            type="month"
            name=""
          )
      .inner-chart
        canvas(id="revenue-chart")
    //- End Section 2

    //- Dashboard Top Tour
    .dashboard-top-tour
      .inner-head
        h2.inner-title Top tour bán chạy

        .inner-filter
          select(dashboard-filter-category)
            option(value="") Tất cả danh mục
            each item in categoryList
              option(
                value=item.id
                selected=(categorySelected == item.id)
              ) #{item.name}

      if topTourList.length > 0
        .table-1
          table
            thead
              tr
                th Tour
                th(class="inner-center") Lượt đặt

            tbody
              each item in topTourList
                tr
                  td
                    .inner-tour
                      .inner-image
                        img(src=item.avatar alt=item.name)

                      .inner-content
                        .inner-name #{item.name}

                  td(class="inner-center")
                    strong #{item.totalQuantity}
      else
        .inner-empty Chưa có dữ liệu tour bán chạy
    //- End Dashboard Top Tour

    //- Section 3
    .section-3
      h2.inner-title Đơn hàng mới
      .table-1
        table
          thead
            tr
              th Mã
              th Thông tin khách
              th Danh sách tour
              th Thanh toán
              th Trạng thái
              th.inner-text-right Ngày đặt
          tbody
            tr
              td
                .inner-code OD000001
              td
                .inner-text Họ tên: Lê Văn A
                .inner-text SĐT: 0123456789
                .inner-text Ghi chú: Test...
              td
                .inner-item
                  .inner-image
                    img(src="/admin/assets/images/tour-1.jpg", alt="Tour Hạ Long")
                  .inner-content
                    .inner-name Tour Hạ Long
                    .inner-quantity Người lớn: 3 x 1.500.000đ
                    .inner-quantity Trẻ em: 2 x 1.300.000đ
                    .inner-quantity Em bé: 2 x 1.000.000đ
                .inner-item
                  .inner-image
                    img(src="/admin/assets/images/tour-1.jpg", alt="Tour Hạ Long")
                  .inner-content
                    .inner-name Tour Hạ Long
                    .inner-quantity Người lớn: 3 x 1.500.000đ
                    .inner-quantity Trẻ em: 2 x 1.300.000đ
                    .inner-quantity Em bé: 2 x 1.000.000đ
              td
                .inner-text Tổng tiền: 10.000.000đ
                .inner-text Giảm: 400.000đ
                .inner-text Mã giảm: TOURMUAHE2024
                .inner-text Thanh toán: 9.600.000đ
                .inner-text PTTT: Ví Momo
                .inner-text TTTT: Đã thanh toán
              td
                .badge.badge-orange Khởi tạo
              td.inner-text-right
                .inner-text 16:20
                .inner-text 14/05/2026
    //- End Section 3